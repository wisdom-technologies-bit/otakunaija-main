# Copy to .env.local and fill in. Never commit real values.
# `.env*` is gitignored, so this file has to be added with `git add -f`.

# ---- Core ----
DATABASE_URL=postgres://user:password@host/db
ADMIN_PASSWORD=
SESSION_SECRET=
SITE_URL=https://otakunaija.name.ng

# ---- Cron ----
# Bearer token for every /api/cron/* route, including /api/cron/news and
# /api/cron/newsletter. Requests without it get 401.
CRON_SECRET=

# ---- AI (news automation + newsletter copy) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Daily newsletter (lib/newsletter/*) ----
# Brevo transactional sending. Without BREVO_API_KEY the newsletter is prepared
# and previewed but nothing is sent, and the cron/admin say so.
BREVO_API_KEY=
# Compared in constant time against Bearer or ?secret= on
# POST /api/webhooks/brevo. Unset means the webhook refuses everything.
BREVO_WEBHOOK_SECRET=
NEWSLETTER_FROM_EMAIL=press@otakunaija.name.ng
NEWSLETTER_FROM_NAME=OtakuNaija
# Optional; replies fall back to the sender when empty.
NEWSLETTER_REPLY_TO=
# approve (default) = an admin approves each issue; auto = prepare approves it.
NEWSLETTER_MODE=approve
# Hard ceiling on emails per UTC day, oldest-served first.
NEWSLETTER_DAILY_CAP=250
# Required for compliance; printed in every footer.
NEWSLETTER_POSTAL_ADDRESS=

# ---- Media / storage ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
